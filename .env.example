PORT=3100
DATA_DIRECTORY=.data

# DMXAPI: fill only DMX_API_KEY. Never commit the real key.
DMX_API_BASE_URL=https://www.dmxapi.cn/v1
DMX_API_KEY=

# Model selection
DMX_TEXT_MODEL=qwen3.5-plus
DMX_IMAGE_MODEL=qwen-image-2.0

# Request controls: paid calls are never retried automatically.
DMX_REQUEST_TIMEOUT_MS=120000
DMX_TEXT_MAX_OUTPUT_TOKENS=4000
MODEL_MAX_REQUEST_RMB=0.50

# Current DMX price snapshot; update when the provider changes prices.
DMX_TEXT_INPUT_RMB_PER_MILLION=0.40
DMX_TEXT_OUTPUT_RMB_PER_MILLION=2.40
DMX_IMAGE_RMB_PER_CALL=0.158
