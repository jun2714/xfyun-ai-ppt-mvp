# DMXAPI: fill only DMX_API_KEY. Never commit the real key.
DMX_API_BASE_URL=https://www.dmxapi.cn/v1
DMX_API_KEY=

# Model selection
DMX_TEXT_MODEL=gpt-5-mini
DMX_TEMPLATE_MODEL=gpt-5.6-luna
DMX_IMAGE_MODEL=gemini-2.5-flash-image
DMX_IMAGE_API_STYLE=gemini
DMX_GEMINI_BASE_URL=https://www.dmxapi.cn

# Local generation engine: editor 5001, API 8000.
ENGINE_DATA_DIRECTORY=.data/engine
ENGINE_TEMP_DIRECTORY=.runtime/temp
MIGRATE_DATABASE_ON_STARTUP=true
ENGINE_MAX_SCHEMA_RETRIES=1
ENGINE_FORCE_NON_STREAM_STRUCTURED=true
ENGINE_LLM_TIMEOUT_SECONDS=120

# TeachNova SSO bridge (user isolation)
DISABLE_AUTH=true
TEACHNOVA_AUTH_INTROSPECT_URL=http://127.0.0.1:48080/admin-api/system/auth/get-permission-info
TEACHNOVA_TENANT_ID=1
TEACHNOVA_CORS_ORIGINS=http://localhost:3030,http://127.0.0.1:3030

# 产品前端（大纲确认页）。编辑器生成后会跳到这里，勿留空
NEXT_PUBLIC_WEB_APP_URL=http://127.0.0.1:5173
