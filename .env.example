# DMXAPI: fill only DMX_API_KEY. Never commit the real key.
# Kimi planning, Gemini image generation and DMX-routed visual QA can reuse this key.
DMX_API_BASE_URL=https://www.dmxapi.cn/v1
DMX_API_KEY=

# Default model selection for generic slide copy/template/image tasks.
# Keep the expensive reasoning model out of every small per-slide call.
DMX_TEXT_MODEL=gpt-5-mini
DMX_TEMPLATE_MODEL=gpt-5.6-luna
# Gemini 3.1 Flash Image is the current balanced default for semantic accuracy,
# latency and cost. DMXAPI exposes the same model name through its Gemini route.
DMX_IMAGE_MODEL=gemini-3.1-flash-image
DMX_IMAGE_API_STYLE=gemini
DMX_GEMINI_BASE_URL=https://www.dmxapi.cn

# Kindergarten lesson planner fast path. K2.6 runs with thinking disabled so a
# normal outline can finish around one minute instead of waiting on K3's mandatory
# long reasoning. Set kimi-k3 only for a slower premium mode; it will use low effort.
KINDERGARTEN_PLANNER_MODEL=kimi-k2.6
KINDERGARTEN_PLANNER_MAX_TOKENS=8192
KINDERGARTEN_PLANNER_TIMEOUT_SECONDS=55
KINDERGARTEN_PLANNER_REASONING_EFFORT=low
# Optional dedicated OpenAI-compatible override. Leave commented when using DMXAPI.
# KINDERGARTEN_PLANNER_BASE_URL=https://api.moonshot.cn/v1
# KINDERGARTEN_PLANNER_API_KEY=

# Generated-image semantic QA.
# auto will reuse DMX_API_KEY when no direct OpenAI/Google key is configured.
ASSET_SEMANTIC_QA_PROVIDER=auto
# Kimi K3 accepts image input and is a safe shared-key default for semantic checking.
ASSET_SEMANTIC_QA_MODEL=kimi-k3
ASSET_SEMANTIC_QA_CONFIDENCE=0.70

# Local generation engine: editor 5001, API 8000.
ENGINE_DATA_DIRECTORY=.data/engine
ENGINE_TEMP_DIRECTORY=.runtime/temp
MIGRATE_DATABASE_ON_STARTUP=true
ENGINE_MAX_SCHEMA_RETRIES=1
ENGINE_FORCE_NON_STREAM_STRUCTURED=true
ENGINE_LLM_TIMEOUT_SECONDS=120

# TeachNova SSO bridge (user isolation)
DISABLE_AUTH=true
TEACHNOVA_AUTH_INTROSPECT_URL=http://127.0.0.1:48080/admin-api/system/auth/get-permission-info
TEACHNOVA_TENANT_ID=1
TEACHNOVA_CORS_ORIGINS=http://localhost:3030,http://127.0.0.1:3030

# 产品前端（大纲确认页）。编辑器生成后会跳到这里，勿留空
NEXT_PUBLIC_WEB_APP_URL=http://127.0.0.1:5173

# 阿里云 OSS。不配则仍写本机目录。对象键即文件夹，上传时自动出现：
#   ppt/library/{领域}/   素材库（健康、语言、社会、科学、艺术、家园共育、节日、其他）
#   ppt/templates/        自定义模板
#   ppt/images/           AI 生图、上传图
#   ppt/exports/          导出的 PPTX/PDF
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_ENDPOINT=https://oss-rg-china-mainland.aliyuncs.com
ALIYUN_OSS_BUCKET=zhiyiedu
ALIYUN_OSS_PUBLIC_BASE_URL=https://zhiyiedu.oss-rg-china-mainland.aliyuncs.com
ALIYUN_OSS_KEY_PREFIX=ppt
