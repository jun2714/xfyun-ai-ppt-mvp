{
  "name": "sparkdeck",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:engine": "node scripts/dev-engine.mjs",
    "setup:engine": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-engine.ps1",
    "build": "npm --prefix engine/editor run build",
    "typecheck": "npm --prefix engine/editor exec -- tsc --noEmit",
    "verify": "pnpm build && pnpm typecheck && pnpm test",
    "test": "npm --prefix engine/editor test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  }
}
