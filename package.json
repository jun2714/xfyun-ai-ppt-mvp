{
  "name": "sparkdeck",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:app": "pnpm --filter @sparkdeck/web dev",
    "dev:engine": "node scripts/dev-engine.mjs",
    "setup:engine": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-engine.ps1",
    "dev:web": "pnpm --filter @sparkdeck/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm build && pnpm typecheck && pnpm test && pnpm audit:recognition-template",
    "audit:recognition-template": "node scripts/audit-recognition-template.mjs",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  }
}
