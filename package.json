{
  "name": "sparkdeck",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm --parallel --filter @sparkdeck/api --filter @sparkdeck/web dev",
    "dev:api": "pnpm --filter @sparkdeck/api dev",
    "dev:web": "pnpm --filter @sparkdeck/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "start": "pnpm --filter @sparkdeck/api start",
    "verify": "pnpm build && pnpm typecheck && pnpm test",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  }
}
