# ========== xfyun-ai-ppt-mvp 生产环境（宝塔）==========
# 复制为项目根目录 .env 后填写密钥。不要把真实 Key 提交到 Git。

# ---- 通用文字 / 图片网关（DMXAPI） ----
# 当前方案只需要维护这一套 DMX 凭据：DeepSeek、Gemini 生图和快速视觉 QA 都可复用。
DMX_API_BASE_URL=https://www.dmxapi.cn/v1
DMX_API_KEY=

# 通用短文案继续使用成本较低的模型；幼教课程规划走独立模型。
DMX_TEXT_MODEL=gpt-5-mini
DMX_TEMPLATE_MODEL=gpt-5.6-luna
# 本轮测试 Gemini 3.1 Flash Lite Image，优先比较幼教配图延迟和成功率。
DMX_IMAGE_MODEL=gemini-3.1-flash-lite-image
DMX_IMAGE_API_STYLE=gemini
DMX_GEMINI_BASE_URL=https://www.dmxapi.cn
IMAGE_GENERATION_TIMEOUT_SECONDS=75
ASSET_GENERATION_CONCURRENCY=4

# ---- 幼教 Lesson Planner ----
# 标准大纲生成使用 DeepSeek V4 Pro，重点要求整份大纲前后呼应、先教后练、最后回扣目标。
KINDERGARTEN_PLANNER_PROFILE=fast
KINDERGARTEN_PLANNER_FAST_MODEL=deepseek-v4-pro-0813
KINDERGARTEN_PLANNER_FAST_MAX_TOKENS=16000
KINDERGARTEN_PLANNER_FAST_TIMEOUT_SECONDS=180
KINDERGARTEN_PLANNER_FAST_TOTAL_TIMEOUT_SECONDS=420
KINDERGARTEN_PLANNER_DEEPSEEK_THINKING=disabled
# premium 使用更大的 token / timeout 预算，但默认仍是同一个 DeepSeek 模型。
KINDERGARTEN_PLANNER_MODEL=deepseek-v4-pro-0813
KINDERGARTEN_PLANNER_MAX_TOKENS=32768
KINDERGARTEN_PLANNER_TIMEOUT_SECONDS=240
# 只有以后要绕过 DMXAPI、改走其他 OpenAI-compatible 网关时才启用：
# KINDERGARTEN_PLANNER_BASE_URL=https://your-openai-compatible-gateway.example/v1
# KINDERGARTEN_PLANNER_API_KEY=

# ---- 生成后图片语义质检 ----
ASSET_SEMANTIC_QA_PROVIDER=auto
ASSET_SEMANTIC_QA_PROFILE=fast
ASSET_SEMANTIC_QA_MODEL=gpt-5-mini
ASSET_SEMANTIC_QA_CONFIDENCE=0.70
ASSET_SEMANTIC_QA_TIMEOUT_SECONDS=25

ENGINE_DATA_DIRECTORY=.data/engine
ENGINE_TEMP_DIRECTORY=.runtime/temp
MIGRATE_DATABASE_ON_STARTUP=true
ENGINE_MAX_SCHEMA_RETRIES=1
ENGINE_FORCE_NON_STREAM_STRUCTURED=true
ENGINE_LLM_TIMEOUT_SECONDS=120

# ---- 数据库（多用户并发必须用 MySQL/PostgreSQL，SQLite 不支持） ----
DATABASE_URL=mysql://xfyun-ppt:密码@127.0.0.1:3306/xfyun-ppt?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---- 多 worker（建议 CPU 核数 × 2 + 1，至少 2） ----
API_WORKERS=4

DISABLE_AUTH=true
TEACHNOVA_AUTH_INTROSPECT_URL=http://127.0.0.1:48080/admin-api/system/auth/get-permission-info
TEACHNOVA_TENANT_ID=1
TEACHNOVA_CORS_ORIGINS=https://teachnova.com,https://www.teachnova.com

# Node 站点域名（编辑器）
NEXT_PUBLIC_URL=https://ppt.teachnova.com
# 产品前端（web 大纲页）
NEXT_PUBLIC_WEB_APP_URL=http://127.0.0.1:5173
# 浏览器调 API：建议走官网站点反代 /ppt-api
NEXT_PUBLIC_FAST_API=https://teachnova.com/ppt-api
FAST_API_INTERNAL_URL=http://127.0.0.1:8000
CAN_CHANGE_KEYS=false

# 阿里云 OSS
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_ENDPOINT=https://oss-rg-china-mainland-internal.aliyuncs.com
ALIYUN_OSS_BUCKET=zhiyiedu
ALIYUN_OSS_PUBLIC_BASE_URL=https://zhiyiedu.oss-rg-china-mainland.aliyuncs.com
ALIYUN_OSS_KEY_PREFIX=ppt
