    "@sparkdeck/presentation-model": "workspace:*",
    "@sparkdeck/quality-engine": "workspace:*",
    "@sparkdeck/scene-graph": "workspace:*",
    "fastify": "^5.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.20.3"
  }
}
